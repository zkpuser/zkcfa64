FROM --platform=linux/amd64 ubuntu:20.04@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214

ARG DEBIAN_FRONTEND=noninteractive
ARG ZEKRA_APT_SNAPSHOT=20260701T000000Z
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && test "$(dpkg-query -W -f='${Version}' libc6)" = "2.31-0ubuntu9.17" \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i -E \
       "s#http://(archive|security).ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/${ZEKRA_APT_SNAPSHOT}/#" \
       /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       binutils build-essential python3 \
    && test "$(dpkg-query -W -f='${Version}' libc6)" = "2.31-0ubuntu9.18" \
    && test "$(dpkg-query -W -f='${Version}' libc6-dev)" = "2.31-0ubuntu9.18" \
    && test "$(dpkg-query -W -f='${Version}' binutils)" = "2.34-6ubuntu1.11" \
    && test "$(gcc -dumpfullversion)" = "9.4.0" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
